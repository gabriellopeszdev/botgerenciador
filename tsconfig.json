{
  "compilerOptions": {
    /* Configurações de Compilação */
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "outDir": "./dist",
    "rootDir": "./",

    "strict": true,
    "noUncheckedIndexedAccess": true, // Evita erros ao acessar índices de salas
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    
    /* Resolução de Módulos */
    "resolveJsonModule": true,
    "isolatedModules": true,
    "types": ["node"]
  },
  "include": [
    "index.ts",
    "src/**/*.ts",
    "prisma/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "bots/**/*.js", // Ignora os scripts de sala que são JS puro
    "dist"
  ]
}