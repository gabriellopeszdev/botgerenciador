generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum RoomStatus {
  ONLINE
  OFFLINE
  CRASHED
}

enum TokenStatus {
  AVAILABLE
  IN_USE
  EXPIRED
  RATE_LIMITED
}

enum LogType {
  INFO
  SUCCESS
  WARN
  ERROR
  CRASH
  TOKEN_EXPIRED
  COMMAND
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  USER
}

enum AuditAction {
  ROOM_OPEN
  ROOM_CLOSE
  ROOM_RELOAD
  TOKEN_CREATE
  TOKEN_DELETE
  BOT_UPSERT
  BOT_DELETE
  BOT_TOGGLE_ACTIVE
  USER_CREATE
  USER_DELETE
  USER_LOGIN
  USER_LOGIN_FAIL
}

// ─── Models ───────────────────────────────────────────────────────────────────

/// Catalogo dos scripts disponíveis na pasta /bots.
model Bot {
  id            String   @id @default(uuid())
  scriptName    String   @unique  // nome do arquivo sem extensão (ex: "arenaZK")
  displayName   String            // nome in-game definido no script
  description   String?           // descrição opcional para exibição no Discord
  scriptContent String            // conteúdo completo do arquivo .js
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  ownerId String?
  owner   User?   @relation(fields: [ownerId], references: [id], onDelete: SetNull)

  @@index([active])
  @@index([ownerId])
}

/// Representa uma sala de Haxball gerenciada pelo bot.
model Room {
  id          String     @id @default(uuid())
  scriptName  String     // nome do arquivo em /bots (ex: "arenaZK")
  roomName    String     // nome in-game da sala (preenchido após onRoomLink)
  roomUrl     String?    // link de entrada no Haxball
  status      RoomStatus @default(ONLINE)
  startedAt   DateTime   @default(now())
  finishedAt  DateTime?
  playerCount Int        @default(0)
  avgPing     Int?       // ping médio dos jogadores (ms)
  channelId   String?    // ID do canal Discord onde a sala foi aberta (null em registros de catálogo)
  retryCount  Int        @default(0)

  tokenId String? @unique
  token   Token?  @relation(fields: [tokenId], references: [id])

  logs RoomLog[]

  @@index([status])
  @@index([startedAt])
  @@index([channelId])
}

/// Token Haxball gerenciado pelo bot.
model Token {
  id         String      @id @default(uuid())
  value      String      @unique
  status     TokenStatus @default(AVAILABLE)
  expiresAt  DateTime?
  lastUsedAt DateTime?
  createdAt  DateTime    @default(now())

  ownerId String?
  owner   User?   @relation(fields: [ownerId], references: [id], onDelete: SetNull)

  room Room?

  @@index([status])
  @@index([ownerId])
}

/// Snapshot de métricas do servidor — usado para dashboards e gráficos futuros.
model ServerMetric {
  id          String   @id @default(uuid())
  cpuPercent  Float
  ramMb       Float
  roomsOnline Int
  recordedAt  DateTime @default(now())

  @@index([recordedAt])
}

/// Usuário do painel web.
model User {
  id           String   @id @default(uuid())
  username     String   @unique
  passwordHash String
  role         UserRole @default(USER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  bots   Bot[]
  tokens Token[]

  @@index([role])
}

/// Log de eventos de uma sala específica.
model RoomLog {
  id        String   @id @default(uuid())
  type      LogType
  message   String
  createdAt DateTime @default(now())

  roomId String?
  room   Room?   @relation(fields: [roomId], references: [id], onDelete: SetNull)

  @@index([roomId])
  @@index([type])
  @@index([createdAt])
}

/// Usuários do Discord autorizados a usar os comandos do bot.
model AllowedDiscordUser {
  id        String   @id @default(uuid())
  discordId String   @unique
  label     String?
  addedAt   DateTime @default(now())

  @@index([discordId])
}

/// Audit log de ações sensíveis no painel.
model AuditLog {
  id        String      @id @default(uuid())
  action    AuditAction
  actorId   String?
  actorName String?
  targetId  String?
  details   String?
  ip        String?
  createdAt DateTime    @default(now())

  @@index([action])
  @@index([actorId])
  @@index([createdAt])
}

