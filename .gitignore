# Dependências
node_modules/
dist/
build/
web/.next/

# Segurança e Configurações Sensíveis
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.production
active_rooms.json

# Puppeteer e Dados do Navegador
