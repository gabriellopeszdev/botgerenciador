userdatadir/
.cache/

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
logs/
*.log
# Exceto páginas do Next.js que se chamam logs/
!web/src/app/**/logs/

# Sistema Operacional
.DS_Store
Thumbs.db
desktop.ini

